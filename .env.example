APP_VERSION=<version>
APP_ENV=local
LOG_LEVEL=INFO
# Local: SQLite (default). Docker Compose mein Postgres use karenge:
# DATABASE_URL=postgresql://apex:apex@db:5432/apex
DATABASE_URL=sqlite:///./data/apex.db
APP_IMAGE=ghcr.io/<username>/<tag>
POSTGRES_USER=<db user here>
POSTGRES_PASSWORD=<your password>
POSTGRES_DB=<db name here>

